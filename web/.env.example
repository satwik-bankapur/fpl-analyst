# Copy to `web/.env.local` (gitignored). Next.js only exposes NEXT_PUBLIC_* vars
# to the browser, so this is the whole frontend config surface.
#
# Local dev  : http://127.0.0.1:8000
# Production : the Render service URL, e.g. https://fpl-analyst-api.onrender.com
#              (set it in the Vercel dashboard, not here — no trailing slash)
#
# Whatever you set must ALSO be the origin allowed by FRONTEND_ORIGIN on the API,
# or every request fails CORS.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
