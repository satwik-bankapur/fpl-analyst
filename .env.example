# Every environment variable this project reads, in one place.
# Copy to `.env` for local dev (`.env` is gitignored). Never commit real values.
#
# Two prefixes, on purpose:
#   FPL_*  -> Layer 1 runtime settings (fpl/config.py)
#   bare   -> Layer 5 delivery surface (api/config.py), named as the spec names them
# The one mapping to remember: spec §5 says DATABASE_URL; the DB engine is owned
# by Layer 1, so the real variable is FPL_DATABASE_URL.

# ---------------------------------------------------------------------------
# Layer 1 — data pipeline (fpl/config.py)
# ---------------------------------------------------------------------------

# SQLite locally; Neon Postgres in production. Postgres URLs must begin with
# `postgresql://`, not `postgres://` (SQLAlchemy rejects the latter).
FPL_DATABASE_URL=sqlite:///fpl.db

# ---------------------------------------------------------------------------
# Layer 5 — delivery surface (api/config.py)
# ---------------------------------------------------------------------------

# CORS: the single frontend origin allowed to call this API. No trailing slash.
# Production = the exact Vercel production URL. Single-origin by design, so
# Vercel preview deployments WILL fail CORS — expected, not a bug.
FRONTEND_ORIGIN=http://localhost:3000

# Bearer for EVERY /api/admin/* route: the writes (notes, euro-weeks), the sync
# trigger, and all the read endpoints behind the /admin operator console and the
# /admin/inspect reasoning inspector. Generate a strong one — 32 random bytes,
# never a memorable string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the ADMIN_TOKEN secret in GitHub Actions or the sync cron 401s.
# EMPTY = admin closed, never open (api/routes.py:87 rejects when unset). That
# fails safe, but it also locks you out of your own dashboard.
ADMIN_TOKEN=

# Resend transactional email. EMPTY = api/mail.py logs and returns (the honest
# local/CI default). Without a verified domain, Resend's shared sender only
# delivers to your own address.
RESEND_API_KEY=
SEND_FROM=FPL Analyst <onboarding@resend.dev>

# In-process APScheduler gate. Leave FALSE on the free tier: Render sleeps after
# ~15 min idle, so the scheduler cannot survive between requests, and
# .github/workflows/sync.yml drives sync instead. Setting this true while that
# workflow exists gives you TWO sync drivers on one DB. Never both.
RUN_SCHEDULER=false

# Brief generations per IP per hour. Cache hits are exempt (layer5 §1.1).
BRIEF_RATE_LIMIT=5
BRIEF_RATE_WINDOW_S=3600

# Public POST requests per IP per hour, counted whether or not anything is
# generated. Bounds `draft_squads` growth (POST /api/brief writes a row before the
# cache is read) and welcome-email volume (POST /api/signup). Deliberately well
# above BRIEF_RATE_LIMIT — this is an abuse ceiling, not the generation budget.
REQUEST_RATE_LIMIT=30
REQUEST_RATE_WINDOW_S=3600

# Failed /api/admin/* auth attempts per IP before the surface answers 429.
# Successes are never counted, so this cannot lock out a working operator.
ADMIN_FAIL_LIMIT=30
ADMIN_FAIL_WINDOW_S=900

# FastAPI's /docs, /redoc and /openapi.json. FALSE in production: the schema is a
# complete map of every admin route and request shape. Set true locally to browse.
DOCS_ENABLED=false

# ---------------------------------------------------------------------------
# Layer 4 — LLM writer (writer/config.py)
# ---------------------------------------------------------------------------
# NOT IN THE SERVING PATH TODAY. api/service.py routes briefs through the Layer 3
# deterministic stub writer; writer/llm.py is built and tested but nothing calls
# it. Setting a key here changes nothing until that wiring lands.
FPL_WRITER_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Stage B — payments, tokens and the weekly send (built 2026-08-01, OFF by default)
# ---------------------------------------------------------------------------

# HS256 secret for tokenized full-view brief links (api/tokens.py). MINIMUM 32
# characters, checked at startup: with PAYWALL_ENABLED or SEND_ENABLED true, a
# weak or empty secret makes the app refuse to boot (api/main._check_stage_b_config).
# That is deliberate — a guessable key means anyone can forge a full-view token
# for any team, which is the paid product given away.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIEF_TOKEN_SECRET=
# Set during a rotation, then remove. Tokens signed with EITHER secret verify, so
# links already sitting in inboxes keep working across the change.
BRIEF_TOKEN_SECRET_PREV=

# Paddle Billing. PADDLE_WEBHOOK_SECRET is the NOTIFICATION DESTINATION secret,
# not the API key — they are different strings and mixing them up rejects every
# webhook. EMPTY = the webhook rejects everything (fail closed, same rule as
# ADMIN_TOKEN), so no subscription can ever be granted.
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_API_BASE=https://sandbox-api.paddle.com
# THE price map. A client sends a plan NAME ("monthly"/"season") and the server
# resolves the id here, so a price never round-trips through the browser.
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_SEASON=
# Calendar year the one-time season pass expires in (30 June). Paddle sends no
# period for a one-off purchase, so the product defines it. BUMP EVERY SUMMER.
SEASON_PASS_END_YEAR=2027
# Reject a signed webhook older than this. Paddle signs the timestamp, so this is
# replay protection, not a clock-skew allowance.
PADDLE_REPLAY_WINDOW_S=300

# Flips the free-tier paywall. Gating itself is graph/sections.py's allow-list and
# lives nowhere else; this only decides whether it runs.
PAYWALL_ENABLED=false

# The weekly post-deadline batch (api/send.py). FALSE = the batch refuses to run
# at all. With RESEND_API_KEY empty it will run, claim send_log rows and deliver
# nothing — check both together.
SEND_ENABLED=false
# Whole-batch ceiling. A runaway loop that mails the list twice is unrecoverable;
# a batch that stops at the cap and says so is a Tuesday morning.
SEND_MAX_RECIPIENTS=2000

# Base URLs used to build links INSIDE emails. Kept separate from FRONTEND_ORIGIN
# (a CORS allow-list entry) so changing one cannot silently change the other.
#   PUBLIC_WEB_URL — the site: brief links, the visible unsubscribe link.
#   PUBLIC_API_URL — this API, and ONLY for the RFC 8058 one-click
#                    List-Unsubscribe header, which a mail client POSTs to with
#                    no human present. It must be an origin that serves /api/*.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://127.0.0.1:8000

# Whole-service brief generations per window, across every caller (audit §C2).
# The per-IP limit stops one abuser; this caps the bill when the per-IP limit has
# a bug. A circuit breaker, not a quota — size it well above real demand.
GLOBAL_GENERATION_LIMIT=500
GLOBAL_GENERATION_WINDOW_S=3600

# ---------------------------------------------------------------------------
# Accounts + auth (2026-08-04) — api/accounts.py
# ---------------------------------------------------------------------------
# THE FREE BRIEF NEEDS NONE OF THIS. Every variable below affects the PAID tier
# only; with all of them empty the site still serves free briefs to anonymous
# readers, which is the design constraint the accounts build was given.

# Google OAuth. BOTH or NEITHER — with the client id empty, /api/auth/google/*
# answers 404 and only the magic link is offered. A half-configured provider
# fails at Google's redirect, which is the worst place to discover it.
# The redirect URI must match the Google console entry EXACTLY (string compare).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Terms version presented at signup. BUMP THIS WHEN THE TERMS CHANGE and edit
# web/app/privacy/page.tsx in the same commit: every account whose stored version
# differs is prompted to re-accept before any paid section is served, so a bump
# with no text change asks people to re-agree to the same words.
TERMS_VERSION=2026-08-04

# Session lifetime, and the magic link's much shorter one. The link IS the
# credential, so it is minutes; the session is a browser convenience.
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15

# Session cookie flags. SECURE MUST STAY TRUE ANYWHERE THAT IS NOT PLAIN-HTTP
# LOCAL DEV — false ships session cookies in the clear.
# SameSite: 'lax' is correct when the API and web app share a registrable domain
# (api.example.com + example.com), which is the launch topology. Use 'none' (which
# REQUIRES Secure) only for a genuinely cross-site deployment. Never 'strict': it
# drops the cookie on the magic-link click, which arrives as a cross-site
# top-level navigation from a mail client.
# DOMAIN: set to the shared parent (".example.com") so the cookie reaches both
# hosts. Empty = host-only, correct for local dev.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# Magic-link request caps, both DB-backed (they survive a Render sleep). Two axes
# because they stop different attacks: per-IP stops one host enumerating many
# addresses; per-address stops many hosts mailbombing one victim, which is under
# the per-IP cap on every single request.
AUTH_LINK_LIMIT=5
AUTH_LINK_WINDOW_S=3600
AUTH_LINK_PER_EMAIL_LIMIT=5
# Verifications / OAuth callbacks per IP — a token-guessing ceiling.
AUTH_VERIFY_LIMIT=30
AUTH_VERIFY_WINDOW_S=900

# ---------------------------------------------------------------------------
# Frontend (web/.env.local — separate file, Next.js only reads NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
