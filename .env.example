# Every environment variable this project reads, in one place.
# Copy to `.env` for local dev (`.env` is gitignored). Never commit real values.
#
# Two prefixes, on purpose:
#   FPL_*  -> Layer 1 runtime settings (fpl/config.py)
#   bare   -> Layer 5 delivery surface (api/config.py), named as the spec names them
# The one mapping to remember: spec §5 says DATABASE_URL; the DB engine is owned
# by Layer 1, so the real variable is FPL_DATABASE_URL.

# ---------------------------------------------------------------------------
# Layer 1 — data pipeline (fpl/config.py)
# ---------------------------------------------------------------------------

# SQLite locally; Neon Postgres in production. Postgres URLs must begin with
# `postgresql://`, not `postgres://` (SQLAlchemy rejects the latter).
FPL_DATABASE_URL=sqlite:///fpl.db

# ---------------------------------------------------------------------------
# Layer 5 — delivery surface (api/config.py)
# ---------------------------------------------------------------------------

# CORS: the single frontend origin allowed to call this API. No trailing slash.
# Production = the exact Vercel production URL. Single-origin by design, so
# Vercel preview deployments WILL fail CORS — expected, not a bug.
FRONTEND_ORIGIN=http://localhost:3000

# Bearer token for POST /api/admin/* (notes, euro-weeks, sync). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the ADMIN_TOKEN secret in GitHub Actions or the sync cron 401s.
ADMIN_TOKEN=

# Resend transactional email. EMPTY = api/mail.py logs and returns (the honest
# local/CI default). Without a verified domain, Resend's shared sender only
# delivers to your own address.
RESEND_API_KEY=
SEND_FROM=FPL Analyst <onboarding@resend.dev>

# In-process APScheduler gate. Leave FALSE on the free tier: Render sleeps after
# ~15 min idle, so the scheduler cannot survive between requests, and
# .github/workflows/sync.yml drives sync instead. Setting this true while that
# workflow exists gives you TWO sync drivers on one DB. Never both.
RUN_SCHEDULER=false

# Brief generations per IP per hour. Cache hits are exempt (layer5 §1.1).
BRIEF_RATE_LIMIT=5
BRIEF_RATE_WINDOW_S=3600

# ---------------------------------------------------------------------------
# Layer 4 — LLM writer (writer/config.py)
# ---------------------------------------------------------------------------
# NOT IN THE SERVING PATH TODAY. api/service.py routes briefs through the Layer 3
# deterministic stub writer; writer/llm.py is built and tested but nothing calls
# it. Setting a key here changes nothing until that wiring lands.
FPL_WRITER_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Stage B — NOT IMPLEMENTED. Listed so the flip is "fill in", not "rediscover".
# ---------------------------------------------------------------------------
# JWT secret for tokenized full-view brief links. Nothing mints or verifies
# tokens yet (the `token` query param on GET /api/brief/{team_id}/{gw} is
# accepted and ignored — see the layer5 §8 note).
BRIEF_TOKEN_SECRET=

# Paddle. No code reads these yet: there is no checkout route, no webhook route,
# and no subscriptions/webhook_events tables. See docs/STATUS.md §3.
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_MONTHLY=
# PADDLE_PRICE_SEASON=

# Flips the free-tier paywall. The gating MECHANISM exists and is proven
# fail-closed (graph/sections.py + tests/test_sections.py), but nothing reads
# this variable yet — api/service.PAYWALL is a False constant. Wiring it is a
# one-line change there.
# PAYWALL_ENABLED=false

# ---------------------------------------------------------------------------
# Frontend (web/.env.local — separate file, Next.js only reads NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
